# Supabase -> Project Settings -> Database -> Connection string (URI, "Transaction" pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# developer.clashroyale.com -> create key, allowlist IP 45.79.218.79 (RoyaleAPI proxy)
CLASH_API_TOKEN=

# Leave as proxy unless you have a static IP of your own
CLASH_API_BASE=https://proxy.royaleapi.dev/v1

# How often to poll every tracked player (minutes)
POLL_EVERY_MINUTES=20

PORT=3000
